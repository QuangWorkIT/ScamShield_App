# Backend configuration. Generate JWT_SECRET following README.md before running.
JWT_SECRET=
JWT_EXPIRATION_MS=3600000
JWT_REFRESH_EXPIRATION_MS=604800000

# Database (defaults match docker-compose.yml's published PostgreSQL port)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5433/scamshield-db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres

# Redis (defaults to the local Redis container)
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379
SPRING_DATA_REDIS_PASSWORD=

FIREBASE_WEB_API_KEY=
SMS_OTP_MAX_REQUESTS_PER_24_HOURS=10
# Email OTP
MAIL_DISPLAY_NAME=ScamShield
MAIL_USERNAME=
MAIL_PASSWORD=
EMAIL_OTP_EXPIRATION_MS=300000
PHONE_OTP_EXPIRATION_MS=300000
CONTACT_VERIFICATION_EXPIRATION_MS=600000

# S3 Configurations
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=evidences
AWS_S3_ENDPOINT_OVERRIDE=
AWS_DISPUTE_BUCKET_NAME=evidences
DISPUTE_FILE_URL_EXPIRATION_SECONDS=900

# Google OAuth Configuration
GOOGLE_CLIENT_ID=

# Scam checks: fallback limit when no registered-user/rank quota policy exists
SCAM_CHECK_REGISTERED_DAILY_LIMIT=10
SCAM_CHECK_RETENTION_DAYS=30
SCAM_CHECK_RETENTION_CLEANUP_ENABLED=true
SCAM_CHECK_RETENTION_CLEANUP_CRON=0 0 1 * * *

# AI scan service
SCAM_CHECK_AI_ENABLED=true
SCAM_CHECK_AI_BASE_URL=http://localhost:8000
SCAM_CHECK_AI_CONNECT_TIMEOUT_MS=2000
SCAM_CHECK_AI_REQUEST_TIMEOUT_MS=60000


# Business registration checks: XinVoice + Computer Vision business_registration OCR.
# Obtain a production OCR URL from the provider; private documents are never sent to a demo URL by default.
# TODO: OCR is deferred until credentials are available. Set enabled=true only after configuring and testing it.
# With OCR enabled, missing OCR credentials produce HTTP 503 / NOT_CONFIGURED.
# XinVoice credentials are optional: leave BOTH blank for public unauthenticated lookup.
XINVOICE_BASE_URL=https://api.xinvoice.vn
XINVOICE_CLIENT_ID=
XINVOICE_API_KEY=
BUSINESS_LICENSE_OCR_ENABLED=false
BUSINESS_LICENSE_OCR_URL=
BUSINESS_LICENSE_OCR_API_KEY=
BUSINESS_LICENSE_OCR_API_SECRET=
PARTNER_VERIFICATION_CONNECT_TIMEOUT_SECONDS=5
PARTNER_VERIFICATION_READ_TIMEOUT_SECONDS=30
PARTNER_VERIFICATION_TOTAL_BUDGET_SECONDS=60
PARTNER_OCR_MINIMUM_CONFIDENCE=0.9
